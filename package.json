{
  "name": "yahoo_to_anki",
  "version": "1.0.0",
  "description": "Chrome extension to create Anki flashcards from Yahoo dictionary search results",
  "type": "module",
  "scripts": {
    "build": "node build.js",
    "watch": "node build.js --watch",
    "dev": "node build.js --watch",
    "lint": "eslint . --ext .js,.ts",
    "lint:fix": "eslint . --ext .js,.ts --fix",
    "prettier": "prettier --write \"**/*.{js,ts,json,html,css}\"",
    "prettier:check": "prettier --check \"**/*.{js,ts,json,html,css}\"",
    "clean": "rm -rf dist",
    "prebuild": "pnpm clean",
    "postbuild": "copyfiles manifest.json \"images/**/*\" dist/ && copyfiles -f src/sidepanel/sidepanel.html dist/sidepanel/"
  },
  "keywords": [
    "chrome-extension",
    "anki",
    "dictionary",
    "flashcards"
  ],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.11.0",
  "devDependencies": {
    "@eslint/js": "9.27.0",
    "@tsconfig/svelte": "^5.0.4",
    "@types/chrome": "0.0.324",
    "@typescript-eslint/eslint-plugin": "8.33.0",
    "@typescript-eslint/parser": "8.33.0",
    "copyfiles": "2.4.1",
    "esbuild": "^0.25.5",
    "esbuild-svelte": "^0.9.3",
    "eslint": "9.27.0",
    "eslint-config-prettier": "10.1.5",
    "globals": "16.2.0",
    "prettier": "3.5.3",
    "prettier-plugin-svelte": "^3.4.0",
    "svelte": "5.0.0-next.272",
    "svelte-preprocess": "^6.0.3",
    "typescript": "5.8.3"
  }
}
