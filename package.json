{
  "name": "yahoo_to_anki",
  "version": "0.0.1.005",
  "description": "Chrome extension to create Anki flashcards from Yahoo dictionary search results",
  "type": "module",
  "scripts": {
    "build": "node build.js",
    "dev": "node build.js --watch",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:fix": "eslint . --ext .js,.ts --fix",
    "prettier": "prettier --write \"**/*.{js,ts,json,html,css,svelte}\"",
    "prettier:check": "prettier --check \"**/*.{js,ts,json,html,css,svelte}\"",
    "clean": "rm -rf dist dist.zip",
    "prebuild": "pnpm clean",
    "postbuild": "copyfiles manifest.json \"images/**/*\" dist/ && copyfiles -f src/sidepanel/sidepanel.html dist/sidepanel/",
    "package": "cd dist && zip -r ../dist.zip .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "keywords": [
    "chrome-extension",
    "anki",
    "dictionary",
    "flashcards"
  ],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.11.0",
  "devDependencies": {
    "@eslint/js": "9.27.0",
    "@storybook/addon-svelte-csf": "^5.0.3",
    "@storybook/builder-vite": "^9.0.11",
    "@storybook/svelte": "^9.0.11",
    "@storybook/svelte-vite": "^9.0.11",
    "@sveltejs/vite-plugin-svelte": "^5.1.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/svelte": "^5.2.8",
    "@tsconfig/svelte": "^5.0.4",
    "@types/chrome": "0.0.324",
    "@types/node": "^24.0.1",
    "@typescript-eslint/eslint-plugin": "8.33.0",
    "@typescript-eslint/parser": "8.33.0",
    "copyfiles": "2.4.1",
    "esbuild": "^0.25.5",
    "esbuild-svelte": "^0.9.3",
    "eslint": "9.27.0",
    "eslint-config-prettier": "10.1.5",
    "eslint-plugin-storybook": "^9.0.11",
    "eslint-plugin-svelte": "^3.9.2",
    "globals": "16.2.0",
    "jsdom": "^26.1.0",
    "prettier": "3.5.3",
    "prettier-plugin-svelte": "^3.4.0",
    "storybook": "^9.0.11",
    "svelte": "5.0.0-next.272",
    "svelte-preprocess": "^6.0.3",
    "typescript": "5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.3"
  },
  "dependencies": {
    "html-format": "^1.1.7",
    "svelte-highlight": "^7.8.3",
    "zod": "^3.25.64"
  }
}
